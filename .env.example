# Copy to .env and fill in. Keys stay EMPTY in the repo: bring your own.
# With no key at all the app runs in demo mode (deterministic mock model, no network, no cost).

# --- OpenAI (or any OpenAI-compatible endpoint that returns logprobs) ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:8001/v1      # e.g. a vLLM server

# --- Gemini (native API; its OpenAI-compatible endpoint does not return logprobs) ---
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# auto (default): OpenAI if OPENAI_API_KEY is set, else Gemini if GEMINI_API_KEY is set,
# else demo mode. Or force "openai" / "gemini" / "mock".
MULTIVERSE_PROVIDER=auto
# Defaults depend on the provider (gpt-4o-mini / gemini-2.5-flash). Uncomment to override.
# MULTIVERSE_DEFAULT_MODEL=gpt-4o-mini
# MULTIVERSE_MODELS=["gpt-4o-mini","gpt-4.1-mini","gpt-4.1-nano","gpt-4o"]

# --- Server-side guards ---
MULTIVERSE_MAX_TOKENS_LIMIT=512
MULTIVERSE_MAX_TOP_LOGPROBS=20
MULTIVERSE_MAX_EXPLORE_NODES=24
MULTIVERSE_MAX_PROMPT_CHARS=8000
MULTIVERSE_MAX_TREE_NODES=300
MULTIVERSE_MAX_CONCURRENCY=4
MULTIVERSE_CACHE_SIZE=512
MULTIVERSE_CACHE_TTL=3600
MULTIVERSE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Public hosting (0 = disabled). Counted in upstream model calls made with the server key. ---
MULTIVERSE_RATE_LIMIT_CALLS=0
MULTIVERSE_RATE_LIMIT_WINDOW=600
MULTIVERSE_DAILY_CALL_CAP=0
MULTIVERSE_ALLOW_BYOK=true
MULTIVERSE_BYOK_RATE_MULTIPLIER=5
# Set to the number of reverse proxies in front of the app (1 on Hugging Face Spaces).
MULTIVERSE_TRUSTED_PROXY_HOPS=0
