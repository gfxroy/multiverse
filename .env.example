# Copy to .env and fill in. Leave OPENAI_API_KEY empty to run in demo mode
# (a deterministic mock model; no network calls, no cost).
OPENAI_API_KEY=

# Optional: point at an OpenAI-compatible endpoint that supports logprobs.
# OPENAI_BASE_URL=

# auto (default): OpenAI if OPENAI_API_KEY is set, else demo mode. Or force "openai" / "mock".
MULTIVERSE_PROVIDER=auto
MULTIVERSE_DEFAULT_MODEL=gpt-4o-mini
# JSON list of models shown in the picker (users can also type any model name).
MULTIVERSE_MODELS=["gpt-4o-mini","gpt-4.1-mini","gpt-4.1-nano","gpt-4o"]

# Server-side guards
MULTIVERSE_MAX_TOKENS_LIMIT=512
MULTIVERSE_MAX_EXPLORE_NODES=24
MULTIVERSE_CACHE_SIZE=512
MULTIVERSE_CACHE_TTL=3600
MULTIVERSE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
